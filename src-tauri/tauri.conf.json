{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wishboard",
  "mainBinaryName": "Wishboard",
  "version": "1.0.0",
  "identifier": "com.wishboard.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Wishboard",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "shortDescription": "Gacha pull tracker and pity counter",
    "publisher": "Wishboard contributors",
    "copyright": "Copyright (c) 2026 Wishboard contributors"
  }
}
